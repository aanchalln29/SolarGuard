# =============================================================================
# SolarGuard — Environment Configuration Template
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# =============================================================================

# Django Security Settings
# Generate a new random secret key for production environments
DJANGO_SECRET_KEY=django-insecure-solarguard-local-dev-team-secret-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# AI Model Selection & Inference Settings
# Active model version: 'v3' (MobileNetV2 CNN v3.0, default), 'v2', or 'v1'
SOLARGUARD_MODEL_VERSION=v3
SOLARGUARD_USE_REAL_CNN=True
SOLARGUARD_USE_DEV_MOCK=False
SOLARGUARD_CONFIDENCE_THRESHOLD=60.0

# Optional: Explicit Model File Paths (Leave commented to use default ml_models/)
# SOLARGUARD_CNN_MODEL_PATH=ml_models/solarguard_model_v3.keras
# SOLARGUARD_CNN_METADATA_PATH=ml_models/model_metadata_v3.json

# Razorpay Payment Gateway (Test Mode / Sandbox)
# Generate your free test API keys at https://dashboard.razorpay.com/app/keys
# Never commit your secret key or actual credentials to GitHub.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
