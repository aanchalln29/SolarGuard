# =============================================================================
# SolarGuard — Git Ignore Configuration
# Clean & Secure Team Collaboration Settings
# =============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django Database & Runtime State
db.sqlite3
db.sqlite3-journal
db.sqlite3.backup*
*.sqlite3
staticfiles/
*.log

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# User-Uploaded Media (Preserve Directory Structures via .gitkeep)
media/inspections/*
!media/inspections/.gitkeep
media/installations/*
!media/installations/.gitkeep
media/maintenance/*
!media/maintenance/.gitkeep

# Sample Test Images (Preserve Canonical Verification Samples Only)
media/sample_test_images/*
!media/sample_test_images/.gitkeep
!media/sample_test_images/sample_*.jpg

# Large Training Datasets & Archives
data/
Trained model Colab/
*.zip
*.tar.gz
*.rar
*.7z

# ML Model Checkpoints & Staged Candidates
# Exclude all .keras / .h5 models by default, and candidate models
*.h5
*.keras
ml_models/candidates/
# Explicitly track ONLY the verified active v3.0 model artifact (9.25 MB)
!ml_models/solarguard_model_v3.keras

# IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*.backup_baseline
*backup_pre_cleanup*
Thumbs.db
Desktop.ini
.DS_Store

# Temporary Scratch Scripts & Task Artifacts
scratch/
.gemini/
.system_generated/
